@page "/home"
@rendermode InteractiveServer

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="app-container">
    <nav class="sidebar d-flex flex-column flex-shrink-0 p-3">
        <a href="/home" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-dark text-decoration-none px-2">
            <i class="bi bi-shield-lock-fill fs-4 text-primary me-2"></i>
            <span class="fs-6 fw-bold tracking-tight">Maria Ortiz</span>
        </a>
        <hr class="border-secondary opacity-15">
        <ul class="nav nav-pills flex-column mb-auto gap-1">
            <li>
                <button class="nav-link w-100 text-start @(ActiveTab == "dashboard" ? "active" : "")" @onclick='() => ChangeTab("dashboard")'>
                    <i class="bi bi-speedometer2 me-2"></i> Dashboard
                </button>
            </li>
            <li>
                <button class="nav-link w-100 text-start @(ActiveTab == "investir" ? "active" : "")" @onclick='() => ChangeTab("investir")'>
                    <i class="bi bi-graph-up-arrow me-2"></i> Investir
                </button>
            </li>
            <li>
                <button class="nav-link w-100 text-start @(ActiveTab == "despesas" ? "active" : "")" @onclick='() => ChangeTab("despesas")'>
                    <i class="bi bi-wallet2 me-2"></i> Despesas
                </button>
            </li>
            <li>
                <button class="nav-link w-100 text-start @(ActiveTab == "metas" ? "active" : "")" @onclick='() => ChangeTab("metas")'>
                    <i class="bi bi-bullseye me-2"></i> Metas
                </button>
            </li>
        </ul>
        <hr class="border-secondary opacity-15">
        <div class="dropdown">
            <button class="btn btn-light w-100 text-start text-secondary small border d-flex align-items-center justify-content-between shadow-none" @onclick="Logout">
                <span><i class="bi bi-box-arrow-left me-2"></i> Sair</span>
                <span class="badge bg-light text-secondary border">v1.0</span>
            </button>
        </div>
    </nav>

    <main class="main-content">
        <header class="topbar d-flex justify-content-between align-items-center px-4 py-3 mb-4">
            <h1 class="h5 fw-bold text-dark mb-0 text-capitalize">@ActiveTab</h1>
            <div class="user-badge d-flex align-items-center gap-2">
                <div class="avatar-circle">MO</div>
                <span class="text-secondary small fw-medium">Administrador</span>
            </div>
        </header>

        <div class="content-body px-4 pb-5">
            @if (ActiveTab == "dashboard")
            {
                <div class="animate-fade-in">
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="card-metric p-4 rounded-4">
                                <span class="text-muted small">Saldo Total</span>
                                <h3 class="text-dark fw-bold mt-2">R$ 45.850,00</h3>
                                <span class="text-success small fw-medium"><i class="bi bi-arrow-up-right"> +12% este mês</i></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-metric p-4 rounded-4">
                                <span class="text-muted small">Investimentos</span>
                                <h3 class="text-dark fw-bold mt-2">R$ 32.100,00</h3>
                                <span class="text-primary small fw-medium"><i class="bi bi-shield-check"> Rendimento ativo</i></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card-metric p-4 rounded-4">
                                <span class="text-muted small">Despesas do Mês</span>
                                <h3 class="text-dark fw-bold mt-2">R$ 4.250,00</h3>
                                <span class="text-danger small fw-medium"><i class="bi bi-arrow-down-right"> -4% vs. anterior</i></span>
                            </div>
                        </div>
                    </div>

                    <div class="card-metric p-4 rounded-4 mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div>
                                <h5 class="fw-bold text-dark mb-1">Evolução de Despesas</h5>
                                <p class="text-muted small mb-0">Comportamento financeiro nos últimos 12 meses</p>
                            </div>
                            <span class="badge bg-light text-secondary border px-3 py-2">Anual</span>
                        </div>

                        <div class="chart-container">
                            <div class="chart-bars">
                                @{
                                    var meses = new[] { ("Nov", 3800), ("Dez", 5200), ("Jan", 4100), ("Fev", 3900), ("Mar", 4500), ("Abr", 4200), ("Mai", 4800), ("Jun", 4150), ("Jul", 4300), ("Ago", 3950), ("Set", 4400), ("Out", 4250) };
                                    int maxVal = 6000; // teto para proporção
                                    foreach (var m in meses)
                                    {
                                        int alturaPercentual = (m.Item2 * 100) / maxVal;
                                        <div class="bar-group" title="@m.Item1: R$ @m.Item2">
                                            <div class="bar-fill" style="height: @alturaPercentual%;"></div>
                                            <span class="bar-label">@m.Item1</span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <div class="card-metric p-4 rounded-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold text-dark mb-0">Despesas Recentes</h5>
                            <button class="btn btn-sm btn-light border text-secondary">Ver todas</button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 custom-table">
                                <thead class="text-muted small text-uppercase">
                                    <tr>
                                        <th class="border-0 bg-transparent">Descrição</th>
                                        <th class="border-0 bg-transparent">Categoria</th>
                                        <th class="border-0 bg-transparent">Data</th>
                                        <th class="border-0 bg-transparent text-end">Valor</th>
                                    </tr>
                                </thead>
                                <tbody class="small">
                                    <tr>
                                        <td class="fw-medium text-dark"><i class="bi bi-hdd-rack text-primary me-2"></i> Servidor Cloud AWS</td>
                                        <td><span class="badge bg-light text-secondary border">Tecnologia</span></td>
                                        <td class="text-muted">26 Out 2026</td>
                                        <td class="text-end fw-semibold text-danger">- R$ 850,00</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-medium text-dark"><i class="bi bi-building text-secondary me-2"></i> Aluguel Escritório</td>
                                        <td><span class="badge bg-light text-secondary border">Infraestrutura</span></td>
                                        <td class="text-muted">10 Out 2026</td>
                                        <td class="text-end fw-semibold text-danger">- R$ 2.500,00</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-medium text-dark"><i class="bi bi-cup-hot text-warning me-2"></i> Suprimentos de Copa</td>
                                        <td><span class="badge bg-light text-secondary border">Operacional</span></td>
                                        <td class="text-muted">05 Out 2026</td>
                                        <td class="text-end fw-semibold text-danger">- R$ 450,00</td>
                                    </tr>
                                    <tr>
                                        <td class="fw-medium text-dark"><i class="bi bi-lightning-charge text-success me-2"></i> Conta de Energia</td>
                                        <td><span class="badge bg-light text-secondary border">Utilidades</span></td>
                                        <td class="text-muted">02 Out 2026</td>
                                        <td class="text-end fw-semibold text-danger">- R$ 450,00</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "investir")
            {
                <div class="animate-fade-in">
                    <div class="card-metric p-4 rounded-4">
                        <h4 class="text-dark fw-bold mb-3">Área de Investimentos</h4>
                        <p class="text-muted">Simule e gerencie suas aplicações de renda fixa e variável com liquidez diária.</p>
                        <button class="btn btn-dark btn-sm px-4 shadow-sm">Novo Aporte</button>
                    </div>
                </div>
            }
            else if (ActiveTab == "despesas")
            {
                <div class="animate-fade-in">
                    <div class="card-metric p-4 rounded-4">
                        <h4 class="text-dark fw-bold mb-3">Controle de Despesas</h4>
                        <p class="text-muted">Acompanhe seus gastos divididos por categorias e cartão de crédito corporativo.</p>
                        <button class="btn btn-outline-dark btn-sm px-4">Adicionar Despesa</button>
                    </div>
                </div>
            }
            else if (ActiveTab == "metas")
            {
                <div class="animate-fade-in">
                    <div class="card-metric p-4 rounded-4">
                        <h4 class="text-dark fw-bold mb-3">Metas Financeiras</h4>
                        <p class="text-muted">Estabeleça objetivos de longo prazo e acompanhe o progresso percentual.</p>
                        <button class="btn btn-dark btn-sm px-4 shadow-sm">Criar Meta</button>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

<style>
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        color: #0f172a;
        overflow: hidden;
    }

    .app-container {
        display: flex;
        width: 100vw;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
    }

    .sidebar {
        width: 260px;
        background-color: #ffffff;
        border-right: 1px solid #e2e8f0;
    }

        .sidebar .nav-link {
            color: #64748b;
            border-radius: 8px;
            font-size: 0.9rem;
            padding: 10px 14px;
            transition: all 0.2s ease;
        }

            .sidebar .nav-link:hover {
                color: #0f172a;
                background-color: #f1f5f9;
            }

            .sidebar .nav-link.active {
                color: #ffffff;
                background-color: #0f172a;
                font-weight: 500;
                box-shadow: 0 4px 12px rgba(15, 23, 42, 0.15);
            }

    .main-content {
        flex-grow: 1;
        display: flex;
        flex-direction: column;
        background-color: transparent;
        overflow-y: auto;
    }

    .topbar {
        background-color: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #e2e8f0;
    }

    .card-metric {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.03), 0 8px 10px -6px rgba(0, 0, 0, 0.03);
    }

    .avatar-circle {
        width: 32px;
        height: 32px;
        background: #0f172a;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: bold;
        color: white;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.2);
    }

    /* Estilização do Gráfico de Barras em CSS Puro */
    .chart-container {
        height: 200px;
        display: flex;
        align-items: flex-end;
        padding-top: 20px;
    }

    .chart-bars {
        display: flex;
        justify-content: space-between;
        width: 100%;
        height: 100%;
        align-items: flex-end;
        gap: 12px;
    }

    .bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        height: 100%;
        justify-content: flex-end;
        position: relative;
    }

    .bar-fill {
        width: 100%;
        max-width: 32px;
        background: #0f172a;
        border-radius: 6px 6px 0 0;
        transition: height 0.4s ease, background 0.2s ease;
    }

    .bar-group:hover .bar-fill {
        background: #3b82f6;
    }

    .bar-label {
        font-size: 0.75rem;
        color: #64748b;
        margin-top: 8px;
    }

    .custom-table th {
        font-weight: 600;
        letter-spacing: 0.03em;
    }
</style>